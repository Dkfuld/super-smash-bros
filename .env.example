# Server
PORT=8787
HOST=0.0.0.0
# SQLite database file (mount a persistent volume in production)
DDD_DB_PATH=data/ddd.sqlite
# Where the built client lives (default: apps/client/dist relative to server)
# DDD_CLIENT_DIST=/app/apps/client/dist

# E2E in nonstandard containers: path to a Chromium binary for Playwright
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium

# No secrets ship in client code. All tokens (host, session, reconnect) are
# generated at runtime with crypto.randomBytes and never persisted client-side
# beyond sessionStorage.
